{
  "name": "hallucinated-dungeons-alpha3",
  "version": "0.0.0",
  "private": true,
  "description": "Hallucinated Dungeons Alpha 3 Builder Root. Phase 0 greenfield foundation: Local Arena, development identity, and the canonical browser -> server -> emulator write/read path.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "verify:toolchain": "node tools/verify-toolchain.mjs",
    "workspace:init": "node tools/workspace/init-working-directory.mjs",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "vite build --config vite.config.ts",
    "typecheck": "tsc --project tsconfig.server.json --noEmit && tsc --project tsconfig.client.json --noEmit",
    "arena:start": "node tools/arena/start-arena.mjs",
    "test:unit": "npm run build:server && node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "certify:phase0": "node tools/certification/run-certification.mjs phase-0",
    "certify:phase1": "node tools/certification/run-certification.mjs phase-1",
    "certify:phase2": "node tools/certification/run-certification.mjs phase-2",
    "serve:frozen": "node tools/certification/serve-frozen.mjs",
    "scan:completeness": "node tools/certification/code-completeness-scan.mjs",
    "scan:architecture": "node tools/certification/architecture-conformance.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "firebase-tools": "^13.29.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
