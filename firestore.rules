rules_version = '2';

// Local Arena baseline: deny all client access by default. Canonical writes go
// through server/admin trust (which bypasses rules) per the blueprint's
// server-authoritative model. Product-specific rules are authored by Builder
// as the corresponding Firestore contracts land.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
